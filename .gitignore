# State — contains secrets in PLAINTEXT. Never commit.
*.tfstate
*.tfstate.*
backup.tfstate

# Plugin and module cache — regenerated by `terraform init`.
.terraform/
.terraform.tfstate.lock.info

# Saved plan files — binary, may embed sensitive values.
tfplan
*.tfplan

# Real variable values. The .example file IS committed.
terraform.tfvars
*.auto.tfvars
!repositories.auto.tfvars
!platform.auto.tfvars
*.tfvars.secret

# Local experiments.
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Generated output and OS noise.
out/
crash.log
crash.*.log
.DS_Store

# NOTE: .terraform.lock.hcl is deliberately NOT ignored — it must be committed.modules/*/.terraform.lock.hcl
